{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Botswain: fake robot",
      "type": "debugpy",
      "request": "launch",
      "module": "botswain",
      "args": ["--robot", "robots/fake.yaml"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Botswain: lab CR5 (192.168.5.1)",
      "type": "debugpy",
      "request": "launch",
      "module": "botswain",
      "args": ["--robot", "robots/dobot_cr5.yaml"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Fake Dobot controller",
      "type": "debugpy",
      "request": "launch",
      "module": "botswain.drivers.dobot.fake_controller",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Botswain: Dobot driver vs fake controller",
      "type": "debugpy",
      "request": "launch",
      "module": "botswain",
      "args": ["--robot", "robots/dobot_cr5_fake.yaml"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Botswain + fake Dobot controller",
      "configurations": ["Fake Dobot controller", "Botswain: Dobot driver vs fake controller"],
      "stopAll": true
    }
  ]
}
